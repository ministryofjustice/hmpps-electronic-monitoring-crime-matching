{
  "name": "crime-data-email-generator",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "create-fake-crime-data": "NODE_OPTIONS=--use-system-ca node dist/src/createFakeCrimeData.js",
    "create-synthetic-data": "NODE_OPTIONS=--use-system-ca node dist/src/createSyntheticData.js",
    "create-synthetic-edge-case-data": "NODE_OPTIONS=--use-system-ca node dist/src/createSyntheticEdgeCaseData.js",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --cache --max-warnings 0 --fix",
    "test": "jest",
    "setup": "npm ci && hmpps-npm-script-run-allowlist"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "csv-parse": "7.0.3",
    "hcl2-parser": "1.0.3",
    "csv-stringify": "6.8.3"
  },
  "devDependencies": {
    "@ministryofjustice/eslint-config-hmpps": "^1.0.3",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
